# Database (PostGIS)
DATABASE_URL=postgresql+psycopg://terraform:terraform@db:5432/terraform

# Where uploads and generated rasters go: a local folder, or gs://bucket/prefix on Google Cloud
STORAGE_URL=file:///data

# inline = run terrain jobs in the API process (local dev); cloudrun = start the Cloud Run Job
JOB_RUNNER=inline
GCP_PROJECT=
GCP_REGION=us-west1
TERRAIN_JOB_NAME=terrain-worker

# Clerk authentication (API side). JWKS URL is public; it comes from the Clerk dashboard → API keys.
CLERK_JWKS_URL=https://arriving-basilisk-7168.clerk.accounts.dev/.well-known/jwks.json
# Comma-separated origins allowed to use the API's tokens (the web app's URL)
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
# Local development only: skip sign-in and act as one dev user. Never set in production.
AUTH_DISABLED=false

# Web app (Clerk keys for the web app live in apps/web/.env.local)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_YXJyaXZpbmctYmFzaWxpc2stNzE2OC5jbGVyay5hY2NvdW50cy5kZXYk
CLERK_SECRET_KEY=
API_URL=http://api:8000
# Optional XYZ satellite tiles for the basemap toggle, e.g. https://example.com/{z}/{x}/{y}.jpg
NEXT_PUBLIC_SATELLITE_TILES=
