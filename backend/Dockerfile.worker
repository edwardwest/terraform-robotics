# Terrain worker (Cloud Run Job): PDAL + GDAL from conda-forge, then the backend package.
FROM mambaorg/micromamba:1.5.10
USER root
RUN micromamba install -y -n base -c conda-forge python=3.12 pdal=2.8 gdal rasterio pyproj shapely scipy scikit-image \
    && micromamba clean -a -y
ARG MAMBA_DOCKERFILE_ACTIVATE=1
WORKDIR /app
COPY pyproject.toml ./
COPY src ./src
RUN pip install --no-cache-dir ".[gcp,public-data]"
ENTRYPOINT ["/usr/local/bin/_entrypoint.sh", "tr-worker"]
